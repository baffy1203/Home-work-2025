doctype html
html(lang="uk")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Користувач
    link(rel="stylesheet", href="/css/style.css")
    link(rel="icon", href="/favicon.ico")
  body
    .container
      h1 Деталі користувача

      .card
        h2= user.username
        p Email: #{user.email}
        p Місто: #{user.city}
        p Роль: #{user.role}
        p ID: #{user._id}